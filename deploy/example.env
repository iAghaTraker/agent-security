
# Copy to /etc/agent/security-alert.env and fill in the required ones.

#  REQUIRED
TELEGRAM_BOT_TOKEN=token
TELEGRAM_CHAT_ID=-

#  Telegram identity — approval authority
# Your numeric Telegram user id. When set, ONLY this account can press
# Approve / Reject on incoming requests; every other admin is refused.
AGENT_OWNER_ID=
# Only consulted when AGENT_OWNER_ID is empty. Comma-separated ids.
AGENT_ADMIN_IDS=

#  Monitor on/off 
# Comma-separated monitor keys to switch OFF. Valid keys:
#   ssh        login success / failed logins / sudo commands
#   journal    systemd unit events
#   filesystem file add / change / delete
#   crowdsec   cscli decisions
#   fail2ban   ban / unban / failed login
#   commands   dangerous binaries via auditd
# Anything not listed here stays enabled.
# Example: turn off fail2ban + crowdsec -> AGENT_DISABLE_MONITORS=fail2ban,crowdsec
AGENT_DISABLE_MONITORS=

#  Global alerting 
AGENT_COOLDOWN_SECONDS=300
AGENT_LOG_PATH=/var/log/agent-security.log

#  Journal monitor 
AGENT_SERVICES=nginx.service,redis-server.service
# log lines containing any of these words trigger an alert
AGENT_JOURNAL_KEYWORDS=failed,crash,stopped,restart,watchdog
AGENT_JOURNAL_COOLDOWN_SECONDS=300

#  Filesystem monitor 
# directories to hash-scan (comma-separated)
AGENT_WATCH_ROOTS=/etc/nginx,/etc/ssh,/etc,/opt
AGENT_SKIP_NAMES=node_modules,.next,venv,__pycache__,.git,backups
AGENT_FILE_SCAN_SECONDS=3
AGENT_FILE_MAX_BYTES=10000000
AGENT_FILE_MAX_EVENTS=30
# how many consecutive scans must agree before alerting (noise filter)
AGENT_FILE_CONFIRM_SCANS=2
# where sudo command lines get archived
AGENT_SUDO_AUDIT_LOG=/var/log/agent-security.log

# CrowdSec monitor 
AGENT_CROWDSEC_SCAN_SECONDS=5
AGENT_CROWDSEC_COOLDOWN_SECONDS=60

# Fail2ban monitor 
AGENT_FAIL2BAN_LOG=/var/log/fail2ban.log
AGENT_FAIL2BAN_BAN_COOLDOWN=0
AGENT_FAIL2BAN_UNBAN_COOLDOWN=0
AGENT_FAIL2BAN_FOUND_COOLDOWN=300

#  Dangerous-command monitor (auditd) 
AGENT_AUDIT_LOG=/var/log/audit/audit.log
# audit rule key that tags the execve events we care about
AGENT_AUDIT_KEY=agent-danger
AGENT_DANGEROUS_BINARIES=apt,apt-get,chmod,chown,crontab,curl,dd,dpkg,fdisk,iptables,mkfs,mv,nft,partprobe,poweroff,reboot,rm,rmdir,scp,shutdown,shred,ssh,systemctl,truncate,visudo,wget
AGENT_COMMAND_COOLDOWN_SECONDS=10
# suppress alerts for commands that were recently approved
AGENT_APPROVAL_MATCH_WINDOW=120
AGENT_COMMAND_HISTORY_SIZE=1000

# ---- Approval store tuning --------------------------------------------
# max bans kept in bans.json (oldest expiry dropped first)
APPROVAL_MAX_BANS=1000
# seconds a decided request is kept on disk for post-hoc matching
APPROVAL_AUDIT_RETENTION=3600
